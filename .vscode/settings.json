{
    "IDX.aI.enableInlineCompletion": true,
    "IDX.aI.enableCodebaseIndexing": true,
    
    // TypeScript-Optimierungen
    "typescript.validate.enable": false,
    "typescript.check.npmIsInstalled": false,
    "typescript.tsc.autoDetect": "off",
    "typescript.preferences.includePackageJsonAutoImports": "off",
    "typescript.suggest.autoImports": false,
    "typescript.updateImportsOnFileMove.enabled": "never",
    "typescript.preferences.maxResultsForCodeCompletion": 5,
    "typescript.preferences.maxInlayHintLength": 10,
    "typescript.format.enable": false,
    "typescript.suggest.enabled": false,
    "typescript.reportStyleChecksAsWarnings": false,
    "typescript.preferences.quoteStyle": "single",
    "typescript.suggest.completeFunctionCalls": false,
    "typescript.suggest.includeCompletionsWithSnippetText": false,
    "typescript.suggest.includeCompletionsForImportStatements": false,
    "typescript.disableAutomaticTypeAcquisition": true,
    "typescript.disableLanguageServiceBasedInlayHints": true,
    "typescript.inlayHints.enumMemberValues.enabled": false,
    "typescript.inlayHints.functionLikeReturnTypes.enabled": false,
    "typescript.inlayHints.parameterNames.enabled": "none",
    "typescript.inlayHints.parameterTypes.enabled": false,
    "typescript.inlayHints.propertyDeclarationTypes.enabled": false,
    "typescript.inlayHints.variableTypes.enabled": false,
    
    // TypeScript-Exclude-Listen
    "typescript.preferences.exclude": [
        "**/node_modules/**",
        "**/.next/**",
        "**/out/**",
        "**/dist/**",
        "**/build/**",
        "**/.turbo/**",
        "**/coverage/**",
        "**/.nyc_output/**",
        "**/tmp/**",
        "**/temp/**",
        "**/.cache/**",
        "**/logs/**",
        "**/*.log",
        "**/GartenMeister-Portable-Direct/**",
        "**/.git/**",
        "**/scripts/**",
        "**/docs/**",
        "**/*.md",
        "**/*.txt",
        "**/*.bat",
        "**/*.ps1",
        "**/*.yaml",
        "**/*.yml",
        "**/*.config.*"
    ],
    
    // File-Exclude
    "files.exclude": {
        "**/node_modules": true,
        "**/.next": true,
        "**/out": true,
        "**/dist": true,
        "**/.git": true,
        "**/coverage": true,
        "**/.nyc_output": true,
        "**/build": true,
        "**/.turbo": true,
        "**/tmp": true,
        "**/temp": true,
        "**/.cache": true,
        "**/logs": true,
        "**/*.log": true,
        "**/GartenMeister-Portable-Direct": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/.vscode-test": true,
        "**/*.tsbuildinfo": true,
        "**/package-lock.json": true,
        "**/yarn.lock": true,
        "**/.env.local": true,
        "**/.env.development": true,
        "**/.env.production": true,
        "**/scripts": true,
        "**/docs": true
    },
    
    // Search-Exclude
    "search.exclude": {
        "**/node_modules": true,
        "**/.next": true,
        "**/out": true,
        "**/dist": true,
        "**/.git": true,
        "**/coverage": true,
        "**/build": true,
        "**/.turbo": true,
        "**/tmp": true,
        "**/temp": true,
        "**/.cache": true,
        "**/logs": true,
        "**/*.log": true,
        "**/GartenMeister-Portable-Direct": true,
        "**/scripts": true,
        "**/docs": true,
        "**/*.md": true,
        "**/*.txt": true,
        "**/*.bat": true,
        "**/*.ps1": true
    },
    
    // Watcher-Exclude
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/.next/**": true,
        "**/out/**": true,
        "**/dist/**": true,
        "**/.git/**": true,
        "**/coverage/**": true,
        "**/build/**": true,
        "**/.turbo/**": true,
        "**/tmp/**": true,
        "**/temp/**": true,
        "**/.cache/**": true,
        "**/logs/**": true,
        "**/*.log": true,
        "**/GartenMeister-Portable-Direct/**": true,
        "**/scripts/**": true,
        "**/docs/**": true,
        "**/*.md": true,
        "**/*.txt": true,
        "**/*.bat": true,
        "**/*.ps1": true
    },
    
    // Editor-Performance-Optimierungen
    "editor.inlayHints.enabled": "off",
    "editor.hover.enabled": "off",
    "editor.quickSuggestions": {
        "other": false,
        "comments": false,
        "strings": false
    },
    "editor.parameterHints.enabled": false,
    "editor.wordBasedSuggestions": "off",
    
    // Allgemeine Performance-Optimierungen
    "problems.maxErrors": 10,
    "problems.sortOrder": "severity",
    "extensions.ignoreRecommendations": true,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": false,
    "workbench.enableExperiments": false,
    "workbench.settings.enableNaturalLanguageSearch": false,
    "search.smartCase": false,
    "search.useGlobalIgnoreFiles": true,
    "search.useParentIgnoreFiles": true,
      // ALLE SPELL-CHECKER KOMPLETT DEAKTIVIERT
    "cSpell.enabled": false,
    "cSpell.showStatus": false,
    "cSpell.showCommandsInEditorContextMenu": false,
    "cSpell.diagnosticLevel": "Hint",
    "cSpell.maxNumberOfProblems": 0,
    "cSpell.checkLimit": 0,
    "cSpell.numSuggestions": 0,
    "cSpell.spellCheckDelayMs": 0,
    "cSpell.enableFiletypes": [],
    "cSpell.enabledLanguageIds": [],
    
    // Spell Right deaktivieren
    "spellright.enabled": false,
    "spellright.statusBarIndicator": false,
    
    // LanguageTool deaktivieren
    "languageTool.enabled": false,
    "languageTool.language": "disabled",
    
    // LTeX deaktivieren (falls installiert)
    "ltex.enabled": false,
    
    // ESLint-Optimierungen
    "eslint.enable": false,
    "eslint.validate": [],
    
    // Weitere Linter deaktivieren
    "stylelint.enable": false,
    "html.validate.scripts": false,
    "html.validate.styles": false,
    "css.validate": false,
    "scss.validate": false,
    "less.validate": false,
    "json.validate.enable": false,
    
    // KRITISCHE Anti-Freeze Einstellungen
    "window.newWindowDimensions": "inherit",
    "window.restoreWindows": "none",
    "window.openFilesInNewWindow": "off",
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 5,
    "workbench.editor.limit.perEditorGroup": true,
    "workbench.editor.closeOnFileDelete": true,
    
    // Git Performance (kritisch!)
    "git.enabled": false,
    "git.autofetch": false,
    "git.autoStash": false,
    "git.autorefresh": false,
    "scm.autoReveal": false,
    
    // Terminal Performance
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.enableImages": false,
    "terminal.integrated.gpuAcceleration": "off",
    
    // Background Tasks reduzieren
    "task.autoDetect": "off",
    "npm.autoDetect": "off",
    "grunt.autoDetect": "off",
    "gulp.autoDetect": "off",
    "jake.autoDetect": "off",
    
    // File System Watchers minimieren
    "files.hotExit": "off",
    "files.useExperimentalFileWatcher": false,
    "chat.tools.terminal.autoApprove": {
        "git -C \"c:\\Users\\wolfg\\Desktop\\GartenMeisterStudio\"": true
    }
}
