                    <CardTitle className="flex items-center gap-2">
                      <Camera className="w-5 h-5" />
                      Webcam Konfiguration
                    </CardTitle>
                    <CardDescription>
                      Kamera-Einstellungen für Garten-Überwachung und Dokumentation
                    </CardDescription>
