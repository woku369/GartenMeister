                    onChange={(e) => updateApiSetting('webcam', 'storageLocation', e.target.value)}
                    placeholder="Downloads/GartenMeister/Webcam"
                  />
                </div>

                <Button onClick={() => testApiConnection('Webcam')}>
                  <TestTube className="w-4 h-4 mr-2" />
                  Kamera testen
                </Button>
              </CardContent>
            </Card>          </div>
